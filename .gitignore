# Claude Code's sandbox masks these paths with empty placeholder files
# (or /dev/null mounts) inside the repo. They are never real content here,
# and committing them breaks clones (empty JSON, files where dirs belong).
.mcp.json
.claude/agents
.claude/commands
.claude/hooks
.claude/skills
.claude/workflows
.claude/routines
.claude/output-styles
.claude/launch.json
.claude/loop.md
.claude/scheduled_tasks.json
.claude/settings.json
.claude/settings.local.json
.claude/.cc-writes/
.claude/worktrees/
.bashrc
.bash_profile
.profile
.zshrc
.zprofile
.gitconfig
.ripgreprc
.idea
.vscode

# Local secrets (API keys). Never commit.
.env

# Written by `python -m pbank.provenance stamp` before copying the code to a machine without .git
CODE_STAMP.json

# Box drivers and exported banks used by the evaluation runs (not committed by design)
/_*.sh
/_evaltype_banks/
# E23's public data, fetched and hash-checked on first use (spar_horizon/related_qualities.py)
/jared/data/related_qualities/*
!/jared/data/related_qualities/README.md

# Built copy of midterm_report/latex/report.pdf (tracked there)
jared/report.pdf
